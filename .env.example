# CryptoDetect Environment Configuration (.env.example)
# Copy this file to .env and replace placeholder values as needed.

# --- Core Backend & Database ---
SECRET_KEY="replace-with-a-random-32-byte-secret"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="30"
DATABASE_URL="sqlite:///./backend/cryptojacking.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/cryptodetect"
DEBUG="True"
VERIFICATION_DEV_MODE="True"
CORS_ORIGINS="http://localhost:3000"

# --- Frontend ---
REACT_APP_API_URL="http://localhost:8000"

# --- ML Model Artifacts & Detection Thresholds ---
# Defaults to ml_models/saved_models/xgboost.pkl and random_forest.pkl
# XGBOOST_MODEL_PATH="ml_models/saved_models/xgboost.pkl"
# RANDOM_FOREST_MODEL_PATH="ml_models/saved_models/random_forest.pkl"
ALERT_THRESHOLD_SCORE="5"
ALERT_MIN_SIGNAL_COUNT="2"
ALERT_SUSTAINED_REQUIRED="3"
ALERT_COOLDOWN_SECONDS="300"

# --- External Threat Intelligence (Optional) ---
VIRUSTOTAL_API_KEY=""
VT_MALICIOUS_THRESHOLD="3"
MALWAREBAZAAR_API_KEY=""
THREAT_INTEL_CACHE_TTL_SECONDS="3600"

# --- Email Notifications (Optional) ---
SMTP_SERVER="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USERNAME=""
SMTP_PASSWORD=""
EMAIL_FROM=""

# --- WhatsApp Notifications via Twilio (Optional) ---
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

